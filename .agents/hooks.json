{
  "git-attrib": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" node ../tools/git-attrib/hook.mjs pre",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" node ../tools/git-attrib/hook.mjs post",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "node-security-update": {
    "SessionStart": [
      {
        "type": "command",
        "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" node ../tools/security-update.mjs --hook",
        "timeout": 30
      }
    ]
  }
}
