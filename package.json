{
  "name": "marp-gui",
  "version": "1.1.0",
  "private": true,
  "description": "Edit Marp slide decks directly in a synchronized VS Code preview, with layout suggestions, a reusable slide library, vector PDF export and presenting (macOS / Windows).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ShohTagawa/marp-GUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShohTagawa/marp-GUI.git"
  },
  "bugs": {
    "url": "https://github.com/ShohTagawa/marp-GUI/issues"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "setup:check": "node tools/setup.mjs --check",
    "security": "node tools/security-update.mjs",
    "security:check": "node tools/security-update.mjs --check",
    "pdf": "node tools/marp-pdf/build-pdf.mjs",
    "pdf:safe": "node tools/marp-pdf/build-pdf.mjs --chunk 12",
    "present": "node tools/marp-present/present.mjs",
    "png": "node tools/marp-png.mjs",
    "lint": "node tools/tsutawaru-lint.mjs",
    "library": "node tools/marp-library.mjs index && node tools/marp-library.mjs thumbs && node tools/marp-library.mjs corpus",
    "corpus": "node tools/marp-library.mjs corpus",
    "test": "node tools/run-tests.mjs",
    "bench": "node tools/marp-scroll-sync/bench/latency.bench.cjs",
    "screenshots": "node tools/marp-scroll-sync/bench/screenshots.cjs",
    "demo:ranking": "node tools/demo/revision-ranking-demo.mjs"
  },
  "dependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  },
  "engines": {
    "node": ">=20"
  }
}
